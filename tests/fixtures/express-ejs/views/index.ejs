<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>Commerce Admin</title><style>*{box-sizing:border-box}body{margin:0;background:#fff;color:#293833;font:13px 'Apple SD Gothic Neo','Segoe UI',sans-serif}nav{padding:22px 30px;border-bottom:1px solid #e9ece7;display:flex;gap:28px;align-items:center}nav b{font:600 21px Georgia,serif;margin-right:35px}nav a{color:#859086;text-decoration:none;font-size:11px}nav a:first-of-type{color:#32765b}main{padding:35px 30px}small{color:#8a968d;font-size:10px}h1{font-size:25px;margin:9px 0}header{display:flex;justify-content:space-between;align-items:center}button{background:#2b7359;color:white;border:0;border-radius:4px;padding:10px 15px;font:inherit;font-size:11px;cursor:pointer}.stats{display:flex;border:1px solid #e0e6dd;border-radius:5px;margin:24px 0}.stats div{flex:1;padding:18px 20px;border-right:1px solid #e6ebe2}.stats div:last-child{border:0}.stats b{display:block;font-size:24px;margin-top:7px;font-weight:500}.stats em{font-size:10px;color:#6a9571;font-style:normal}form{display:flex;gap:10px;background:#f7f9f5;border:1px solid #e5e9e1;border-radius:5px;padding:15px;margin-bottom:23px}input{padding:9px 12px;border:1px solid #dce2d7;border-radius:3px;background:white;flex:1;min-width:80px;font:inherit;font-size:11px}table{width:100%;border-collapse:collapse;text-align:left;font-size:11px}th{background:#f8faf6;color:#8d988d;font-weight:400}th,td{padding:15px 12px;border-bottom:1px solid #e7ece3}td:first-child{font:10px monospace;color:#859583}.pill{border-radius:3px;background:#eef4e8;color:#698154;padding:5px 7px;font-size:10px}.meta{display:flex;justify-content:space-between;color:#8d988b;font-size:10px;margin:18px 0}</style></head><body><nav><b>morrow.</b><a href="/">대시보드</a><a href="/">주문 관리</a><a href="/">상품</a><a href="/">고객</a></nav><main><header><div><small>COMMERCE / ORDERS</small><h1>주문 관리</h1><small>오늘의 주문과 배송 현황을 한눈에 확인하세요.</small></div><button type="button">내보내기 ↗</button></header><section class="stats"><div><small>전체 주문</small><b>128 <em>↑ 12.4%</em></b></div><div><small>결제 완료</small><b>86</b></div><div><small>배송 준비</small><b>24</b></div><div><small>배송 완료</small><b>18</b></div></section><form id="order-search" onsubmit="event.preventDefault()"><input name="keyword" placeholder="주문번호 또는 상품명 검색" aria-label="주문 검색"><button>검색</button></form><div class="meta"><span>전체 주문 <b>128</b></span><span>최근 주문순 ↓</span></div><table><thead><tr><th>주문번호</th><th>상품명</th><th>고객</th><th>결제 금액</th><th>상태</th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><%=order.id%></td><td><%=order.name%></td><td><%=order.customer%></td><td>₩ <%=order.amount%></td><td><span class="pill"><%=order.status%></span></td></tr><% }) %></tbody></table></main></body></html>
